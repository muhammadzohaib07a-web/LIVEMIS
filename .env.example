# Public Supabase values used by the server/auth middleware.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_with_your_publishable_key

# Vite embeds these two public values in the browser bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace_with_your_publishable_key

# Server-only API key. Never prefix this variable with VITE_.
GROQ_API_KEY=replace_with_your_groq_api_key

# Email notifications (new ticket -> MIS Head, ticket assigned -> agent).
# Sign up free at https://resend.com, verify a sending domain (or use their
# onboarding@resend.dev sandbox, which only delivers to your own Resend
# account email until a domain is verified), then create an API key.
RESEND_API_KEY=replace_with_your_resend_api_key
EMAIL_FROM="MIS Support Hub <onboarding@resend.dev>"
# Base URL used to build the "Open in MIS Support Hub" link in emails.
APP_URL=https://livemis-utxn.vercel.app

# Server-only Supabase key used for confirmed account creation.
# Find it in Supabase > Project Settings > API Keys. Never prefix it with VITE_.
# Vercel's Supabase integration may provide the same value as SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_or_secret_key

# One-time bootstrap values for `npm run bootstrap:admin`.
INITIAL_ADMIN_EMAIL=talenthubpro78@gmail.com
INITIAL_ADMIN_PASSWORD=choose_a_strong_password
INITIAL_ADMIN_FULL_NAME=Tahir Ghaffar
INITIAL_ADMIN_EMPLOYEE_ID=MIS-HEAD-01
